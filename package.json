{
  "name": "marginalia",
  "productName": "Marginalia",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for annotating lecture slides and writing Markdown summaries",
  "main": "./out/main/index.js",
  "author": "Mathias Bouhon Keulen",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test:e2e": "electron-vite build && playwright test",
    "deploy": "node scripts/deploy.mjs",
    "screenshots": "electron-vite build && node scripts/screenshots/capture.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vscode/markdown-it-katex": "1.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "katex": "0.16.47",
    "markdown-it": "15.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "perfect-freehand": "1.2.3",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "node-pty": "1.1.0",
    "zod": "4.6.5"
  }
}
